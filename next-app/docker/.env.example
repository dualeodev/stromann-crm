# Domain you've pointed at this server's public IP (A record).
DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com

# Copy these from ../../supabase/docker/.env after generating them per
# https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
ANON_KEY=
SERVICE_ROLE_KEY=

# Optional: basic-auth for studio.${DOMAIN} (uncomment in Caddyfile too).
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
# STUDIO_AUTH_USER=admin
# STUDIO_AUTH_HASH=$2a$14$...
