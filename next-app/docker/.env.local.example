# Copy thành docker/.env.local rồi điền key từ output của `supabase start`.
# (Hai key này local là cố định cho mọi máy — Supabase CLI generate từ
#  JWT secret mặc định trong supabase/config.toml.)

ANON_KEY=
SERVICE_ROLE_KEY=

# Khớp với domain dùng trong supabase/seed.sql (admin@stromann.local).
ADMIN_USERNAME_EMAIL_DOMAIN=stromann.local
